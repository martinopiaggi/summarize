{
  "name": "summarize",
  "title": "Summarize",
  "description": "Summarize video URLs using the local Summarize HTTP API. Two options: paste a URL directly or use clipboard content.",
  "icon": "icon.png",
  "author": "martinopiaggi",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "summarize",
      "title": "Summarize",
      "description": "Summarize a video URL. Paste or type the URL directly next to the command.",
      "mode": "view",
      "arguments": [
        {
          "name": "url",
          "placeholder": "Video URL",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "summarize-clipboard",
      "title": "Summarize Clipboard",
      "description": "Send the clipboard content (video URL) to the Summarize HTTP API",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiEndpoint",
      "type": "textfield",
      "required": false,
      "title": "Summarize API Endpoint",
      "description": "Base URL of the Summarize HTTP API",
      "default": "http://localhost:8000",
      "placeholder": "http://localhost:8000"
    },
    {
      "name": "provider",
      "type": "textfield",
      "required": false,
      "title": "Provider",
      "description": "Provider name from summarizer.yaml (optional)",
      "placeholder": "groq"
    },
    {
      "name": "promptType",
      "type": "textfield",
      "required": false,
      "title": "Prompt Type",
      "description": "Summary style (optional)",
      "placeholder": "Summarization"
    },
    {
      "name": "sidecar",
      "type": "dropdown",
      "required": false,
      "title": "Transcript Sidecar",
      "description": "External transcript service for video URLs",
      "default": "default",
      "data": [
        { "title": "Server default", "value": "default" },
        { "title": "None", "value": "none" },
        { "title": "TranscriptFetch", "value": "transcriptfetch" }
      ]
    },
    {
      "name": "sidecarOrder",
      "type": "dropdown",
      "required": false,
      "title": "Sidecar Order",
      "description": "When the sidecar runs",
      "default": "default",
      "data": [
        { "title": "Server default", "value": "default" },
        { "title": "Fallback: when local transcription fails", "value": "fallback" },
        { "title": "First: before local transcription", "value": "first" }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.83.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix"
  }
}
